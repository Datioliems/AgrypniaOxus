<?xml version="1.0" encoding="utf-8"?>
<!-- Logo thoát ra: scale từ 1.0 → 2.2 + fade out — hiệu ứng phóng to mờ dần -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_interpolator">

    <scale
        android:fromXScale="1.00"
        android:toXScale="2.20"
        android:fromYScale="1.00"
        android:toYScale="2.20"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="550" />

    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0"
        android:duration="550" />

</set>
