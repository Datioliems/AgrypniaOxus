<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0F">

    <!-- Logo icon (chỉ phần biểu tượng, không có chữ) -->
    <ImageView
        android:id="@+id/splash_logo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginBottom="60dp"
        android:src="@drawable/logo_icon"
        android:scaleType="fitCenter"
        android:contentDescription="AgrypniaOxus logo" />

    <!-- Tên app — nhỏ, mờ, bên dưới icon -->
    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="180dp"
        android:text="AgrypniaOxus"
        android:textColor="#55FFFFFF"
        android:textSize="16sp"
        android:letterSpacing="0.12"
        android:fontFamily="sans-serif-light" />

    <!-- Tagline nhỏ phía dưới -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:text="Drowsiness Detection · AI Powered"
        android:textColor="#33FFFFFF"
        android:textSize="11sp"
        android:letterSpacing="0.08" />

</FrameLayout>
